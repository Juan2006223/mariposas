PORT=3000
NODE_ENV=development
SERVE_FRONTEND=false

# Opcion recomendada para Neon, Render, Railway, etc.
DATABASE_URL=

# Credenciales de conexión a PostgreSQL local o remoto
PGHOST=localhost
PGPORT=5432
PGDATABASE=alas_mariposa_db
PGUSER=
PGPASSWORD=
PGSSL=false

# Modo almacenamiento: 'postgres' o 'memory'
STORAGE_MODE=postgres

# Seguridad HTTP
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JSON_BODY_LIMIT=1mb
ADMIN_API_TOKEN=

# Almacenamiento de imagenes y videos en Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_FOLDER=mariposas
